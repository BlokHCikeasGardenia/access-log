# Supabase project credentials (public anon key is safe to expose; RLS protects data)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# GitHub Pages base path (repo name). Leave as / for user/org pages (https://user.github.io/)
# For project pages use e.g. /log-akses/ or /access-log/
# (Build time: a .env.production file with this value wins during `npm run build`.)
VITE_BASE_PATH=/

# Supabase Edge Function that proxies the external gate-log API (see
# supabase/functions/log-gate). Fill in after `supabase functions deploy log-gate`.
# Format: https://<project-ref>.functions.supabase.co/log-gate
VITE_SUPABASE_EDGE_LOG_GATE=

# Supabase Edge Function that proxies the external card-list API (see
# supabase/functions/log-card-list). Fill in after `supabase functions deploy log-card-list`.
# Format: https://<project-ref>.functions.supabase.co/log-card-list
VITE_SUPABASE_EDGE_CARD_LIST=

# Supabase Edge Function that proxies the external gate card-command API (see
# supabase/functions/card-command). Fill in after `supabase functions deploy card-command`.
# Format: https://<project-ref>.functions.supabase.co/card-command
VITE_SUPABASE_EDGE_CARD_COMMAND=

# Supabase Edge Function that proxies the external gate command-result API (see
# supabase/functions/command-result). Fill in after `supabase functions deploy command-result`.
# Format: https://<project-ref>.functions.supabase.co/command-result
VITE_SUPABASE_EDGE_COMMAND_RESULT=

